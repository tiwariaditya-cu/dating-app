PORT=5000
MONGODB_URI=
JWT_SECRET=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=

# Keep password auth disabled so every user signs in with Google.
ALLOW_PASSWORD_AUTH=false

# For hosted apps. Use the exact browser origin, no trailing slash.
# If frontend and backend are on the same domain, PUBLIC_APP_URL is enough.
PUBLIC_APP_URL=https://your-app.example.com
FRONTEND_URL=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
