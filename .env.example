PORT=5000
# Set NODE_ENV=production in Render. Leave it unset locally if you need the
# public DNS fallback for MongoDB Atlas SRV lookups.
NODE_ENV=
MONGODB_URI=
JWT_SECRET=
GEMINI_API_KEY=
# Optional. Leave blank to use the app defaults.
GEMINI_MODEL=
GOOGLE_CLIENT_ID=
OCR_LANGUAGE_HINTS=en,hi

# Enable email/password login alongside Google login.
ALLOW_PASSWORD_AUTH=true

# For hosted apps. Use the exact browser origin, no trailing slash.
# If frontend and backend are on the same domain, PUBLIC_APP_URL is enough.
PUBLIC_APP_URL=https://your-app.example.com
FRONTEND_URL=https://your-frontend.example.com
CORS_ALLOWED_ORIGINS=https://your-frontend.example.com
